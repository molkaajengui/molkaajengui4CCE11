      "item": [
        {
          "name": "Lister les contrats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contrats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contrats"]
            }
          }
        },
        {
          "name": "Consulter un contrat inexistant (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Format d'erreur lisible\", () => {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.statut).to.eql(404);",
                  "    pm.expect(json.message).to.be.a('string');",
                  "    pm.expect(json.horodatage).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
